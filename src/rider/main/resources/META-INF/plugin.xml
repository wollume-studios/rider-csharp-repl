<idea-plugin require-restart="true">
    <id>com.wollumestudios.csharprepl</id>
    <name>C# REPL</name>
    <vendor>Wollume Studios</vendor>
    <description><![CDATA[
        An interactive C# REPL for Rider: run C# snippets in a persistent Roslyn scripting session, inspect variables,
        reference projects, DLLs and NuGet packages, and export the session as a single-file app.
    ]]></description>

    <depends>com.intellij.modules.rider</depends>

    <!-- ReplSettings (application) and ReplSession (project) are light services (@Service). -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="C# REPL" anchor="bottom" icon="/icons/repl.svg"
                    factoryClass="com.wollumestudios.csharprepl.ui.ReplToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="com.wollumestudios.csharprepl.settings" displayName="C# REPL"
                                 instance="com.wollumestudios.csharprepl.settings.ReplConfigurable"/>
        <notificationGroup id="CSharpRepl" displayType="BALLOON"/>
        <!-- A project dropped on a single-file app's editor (.cs outside the solution's projects, or with #: directives) inserts #:project. -->
        <fileDropHandler implementation="com.wollumestudios.csharprepl.singlefile.SingleFileProjectDrop"/>
    </extensions>

    <projectListeners>
        <!-- Saved / externally changed files of referenced projects → change banner (builds: ProjectChangeListener.watchBuilds). -->
        <listener class="com.wollumestudios.csharprepl.refs.ProjectChangeListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="CSharpRepl.Run" class="com.wollumestudios.csharprepl.actions.RunAction"/>
        <action id="CSharpRepl.Stop" class="com.wollumestudios.csharprepl.actions.StopAction"/>
        <action id="CSharpRepl.ToggleAutoRun" class="com.wollumestudios.csharprepl.actions.ToggleAutoRunAction"/>
        <action id="CSharpRepl.Reset" class="com.wollumestudios.csharprepl.actions.ResetAction"/>
        <action id="CSharpRepl.ClearPending" class="com.wollumestudios.csharprepl.actions.ClearPendingAction"/>
        <action id="CSharpRepl.Settings" class="com.wollumestudios.csharprepl.actions.SettingsAction"/>
        <!-- No keymap shortcuts: ReplPanel binds these on the input only (Enter, Shift+Enter, Escape by default, or what the user assigns in the keymap). -->
        <action id="CSharpRepl.Enter" class="com.wollumestudios.csharprepl.actions.EnterKeyAction"/>
        <action id="CSharpRepl.ShiftEnter" class="com.wollumestudios.csharprepl.actions.ShiftEnterKeyAction"/>
        <action id="CSharpRepl.ClearInput" class="com.wollumestudios.csharprepl.actions.ClearInputAction"/>
        <action id="CSharpRepl.AddReference" class="com.wollumestudios.csharprepl.actions.AddReferenceAction"/>
        <action id="CSharpRepl.ReferenceInRepl" class="com.wollumestudios.csharprepl.actions.ReferenceInReplAction">
            <add-to-group group-id="SolutionExplorerPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="CSharpRepl.Rebuild" class="com.wollumestudios.csharprepl.actions.RebuildAction"/>
        <action id="CSharpRepl.RebuildReplay" class="com.wollumestudios.csharprepl.actions.RebuildReplayAction"/>
        <action id="CSharpRepl.RebuildRestore" class="com.wollumestudios.csharprepl.actions.RebuildRestoreAction"/>
        <action id="CSharpRepl.Ignore" class="com.wollumestudios.csharprepl.actions.IgnoreChangeAction"/>
        <action id="CSharpRepl.IgnoreForSession" class="com.wollumestudios.csharprepl.actions.IgnoreForSessionAction"/>
        <action id="CSharpRepl.IgnoreChangesForever" class="com.wollumestudios.csharprepl.actions.IgnoreChangesForeverAction"/>
        <action id="CSharpRepl.NewSingleFileApp" class="com.wollumestudios.csharprepl.singlefile.NewSingleFileAppAction">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
        <action id="CSharpRepl.DumpVariables" class="com.wollumestudios.csharprepl.singlefile.DumpVariablesAction"/>
        <action id="CSharpRepl.ExportToSingleFile" class="com.wollumestudios.csharprepl.singlefile.ExportToSingleFileAction"/>
        <action id="CSharpRepl.ExportToSingleFileExcludeThrown" class="com.wollumestudios.csharprepl.singlefile.ExportToSingleFileExcludeThrownAction"/>
        <action id="CSharpRepl.ExportSplitButton" class="com.wollumestudios.csharprepl.singlefile.ExportSplitButtonAction"/>
        <action id="CSharpRepl.AddProjectDirective" class="com.wollumestudios.csharprepl.singlefile.AddProjectDirectiveAction">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="GenerateGroup" anchor="last"/>
        </action>
        <group id="CSharpRepl.Gear" text="Options" description="References and settings" popup="true" icon="AllIcons.General.Settings">
            <group id="CSharpRepl.References" class="com.wollumestudios.csharprepl.actions.ReferencesGroup"/>
            <reference ref="CSharpRepl.AddReference"/>
            <reference ref="CSharpRepl.NewSingleFileApp"/>
            <separator/>
            <reference ref="CSharpRepl.IgnoreChangesForever"/>
            <reference ref="CSharpRepl.Settings"/>
        </group>
        <group id="CSharpRepl.Toolbar" text="C# REPL">
            <reference ref="CSharpRepl.Run"/>
            <reference ref="CSharpRepl.Stop"/>
            <reference ref="CSharpRepl.ToggleAutoRun"/>
            <reference ref="CSharpRepl.Reset"/>
            <separator/>
            <reference ref="CSharpRepl.ExportSplitButton"/>
            <reference ref="CSharpRepl.DumpVariables"/>
            <separator/>
            <reference ref="CSharpRepl.AddReference"/>
            <reference ref="CSharpRepl.Gear"/>
        </group>
    </actions>
</idea-plugin>
